@Metadata.layer: #CORE

@UI.headerInfo: { title: { type: #STANDARD, value: 'Description' },
                  description: { type: #STANDARD, value: 'Category' } }

annotate view ZAK_C_EXPENSE with

{
  @EndUserText.label: 'UUID'
  @UI.facet: [ { label: 'Expense Details',
                 id: 'GeneralInfo',
                 purpose: #STANDARD,
                 position: 10,
                 type: #IDENTIFICATION_REFERENCE } ]
  @UI.hidden: true
  UUID;

  @UI.hidden: true
  ParentUUID;

  @EndUserText.label: 'Transaction Type'
  @UI.identification: [ { position: 30 } ]
  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 30 } ]
  TransactionType;

  @EndUserText.label: 'Category'
  @UI.identification: [ { position: 40 } ]
  @UI.lineItem: [ { position: 40 } ]
  @UI.selectionField: [ { position: 40 } ]
  Category;

  @EndUserText.label: 'Price'
  @UI.identification: [ { position: 50 } ]
  @UI.lineItem: [ { position: 50 } ]
  @UI.selectionField: [ { position: 50 } ]
  Price;

  @EndUserText.label: 'Description'
  @UI.identification: [ { position: 60 } ]
  @UI.lineItem: [ { position: 60 } ]
  @UI.selectionField: [ { position: 60 } ]
  Description;

  @EndUserText.label: 'Expense Date'
  @UI.identification: [ { position: 70 } ]
  @UI.lineItem: [ { position: 70 } ]
  @UI.selectionField: [ { position: 70 } ]
  ExpenseDate;

  @EndUserText.label: 'Ticket Upload'
  @UI.identification: [ { position: 80 } ]
  @UI.lineItem: [ { position: 80 } ]
  @UI.selectionField: [ { position: 80 } ]
  ticketattachement;

  @UI.hidden: true
  ticketmimetype;

  @UI.hidden: true
  ticketfilename;
}