managed implementation in class ZAK_BP_R_TRIP unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZAK_R_TRIP alias Trip
persistent table zak_trip
extensible
draft table zak_trip_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
  UUID,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt,
  total,
  currency;

  field ( numbering : managed )
  UUID;

  field ( mandatory ) TripType, StartDate, EndDate;

  create;
  update( features : instance );
  delete( features : instance );

  draft action Activate optimized;
  draft action Discard;
  draft action ( features : instance ) Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation check_mandatory_fields;
    validation check_start_prior_to_end_date;
    validation Expense~check_mandatory_fields;
    validation Expense~check_expense_date_within_trip;
    validation Expense~check_amount_is_possitive;
  }


  field ( features : instance ) Status;
  field ( features : instance, mandatory ) Title;

  association _Expense { create ( features : instance ); with draft; }

  validation check_mandatory_fields on save { create; update; }
  validation check_start_prior_to_end_date on save { create; update; }
  determination set_initial_status on save { create; }

  side effects
  {
    entity _Expense affects field Total;
  }

  mapping for zak_trip corresponding extensible
    {
      UUID               = UUID;
      Title              = TITLE;
      TripType           = TRIP_TYPE;
      Status             = STATUS;
      Currency           = CURRENCY;
      Total              = TOTAL;
      StartDate          = START_DATE;
      EndDate            = END_DATE;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }

}

define behavior for ZAK_R_EXPENSE alias Expense
persistent table zak_expense
extensible
draft table zak_expense_d
etag dependent by _Trip
lock dependent by _Trip
authorization dependent by _Trip
{
  field ( readonly )
  UUID,
  ParentUUID;

  field ( numbering : managed )
  UUID;

  field ( mandatory ) TransactionType, Category, Currency, Price, Description;

  update;
  delete;

  validation check_mandatory_fields on save { create; update; }
  validation check_expense_date_within_trip on save { create; update; }
  validation check_amount_is_possitive on save { create; update; }
  determination update_totals on modify { create; delete; field Price; }

  side effects
  {
    field Price affects field _Trip.Total;
  }

  mapping for zak_expense corresponding extensible
    {
      UUID              = UUID;
      ParentUUID        = PARENT_UUID;
      TransactionType   = TRANSACTION_TYPE;
      Category          = CATEGORY;
      Currency          = CURRENCY;
      Price             = PRICE;
      Description       = DESCRIPTION;
      ExpenseDate       = EXPENSE_DATE;
      TicketAttachement = ticket_attachment;
      TicketMimetype    = ticket_mimetype;
      TicketFilename    = ticket_filename;
    }

  association _Trip { with draft; }

}