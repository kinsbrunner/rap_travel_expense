@Metadata.layer: #CORE

@UI.headerInfo: { title: { type: #STANDARD, value: 'Title' },
                  description: { type: #STANDARD, value: 'Status' } }

@UI.lineItem: [{criticality: 'StatusIcon'}]

annotate view ZAK_C_TRIP with

{
  @EndUserText.label: 'UUID'
  @UI.facet: [ { label: 'Trip Information',
                 id: 'GeneralInfo',
                 purpose: #STANDARD,
                 position: 10,
                 type: #IDENTIFICATION_REFERENCE },
               { label: 'Expense Items',
                 id: 'ExpenseItems',
                 purpose: #STANDARD,
                 position: 11,
                 type: #LINEITEM_REFERENCE,
                 targetElement: '_Expense' } ]
  @UI.hidden: true
  UUID;

  @EndUserText.label: 'Title'
  @UI.identification: [ { position: 20 } ]
  @UI.lineItem: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  Title;

  @EndUserText.label: 'Trip Type'
  @UI.identification: [ { position: 30 } ]
  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.textArrangement: #TEXT_FIRST
  TripType;

  @EndUserText.label: 'Status'
  @UI.identification: [ { position: 40, criticality: 'StatusIcon', criticalityRepresentation: #WITH_ICON } ]
  @UI.lineItem: [ { position: 40, criticality: 'StatusIcon', criticalityRepresentation: #WITH_ICON } ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.textArrangement: #TEXT_ONLY
  Status;

  @UI.adaptationHidden: true
  StatusIcon;

  @EndUserText.label: 'Total'
  @UI.identification: [ { position: 50 } ]
  @UI.lineItem: [ { position: 50 } ]
  Total;

  @EndUserText.label: 'Start Date'
  @UI.identification: [ { position: 60 } ]
  @UI.lineItem: [ { position: 60 } ]
  @UI.selectionField: [ { position: 60 } ]
  @Consumption.filter: { selectionType: #INTERVAL, multipleSelections: false } 
  StartDate;

  @EndUserText.label: 'End Date'
  @UI.identification: [ { position: 70 } ]
  @UI.lineItem: [ { position: 70 } ]
//  @UI.selectionField: [ { position: 70 } ]
  EndDate;

  @EndUserText.label: 'Reported By'
  @UI.identification: [ { position: 80 } ]
  @UI.lineItem: [ { position: 80 } ]
  LocalCreatedBy;

  @EndUserText.label: 'Reported On'
  @UI.identification: [ { position: 90 } ]
  LocalCreatedAt;

  @UI.hidden: true
  LocalLastChangedBy;

  @UI.hidden: true
  LocalLastChangedAt;

  @UI.hidden: true
  LastChangedAt;
}